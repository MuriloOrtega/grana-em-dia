# Somente valores PÚBLICOS. Nunca coloque service_role, sb_secret_* ou chaves privadas aqui:
# toda variável EXPO_PUBLIC_* é embutida no aplicativo e pode ser lida por qualquer pessoa.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Recuperação de senha por código: só ligue (on) depois de configurar SMTP próprio e o template
# "Reset Password" com {{ .Token }} no Supabase. Valor público, não é segredo.
# EXPO_PUBLIC_PASSWORD_RESET=on
